# ============================================================
# .gitignore — Primer Analysis Suite
# ============================================================

# ----- Gros fichiers de données génomiques / Large genomic data files -----
# On exclut les séquences FASTA volumineuses (plusieurs Mo/Go)
# Excluding large FASTA sequence files (multi-MB/GB)
sequences_*.fasta
*_aligned.fasta
*_output.fasta
dengue_*.fasta
clustersequences_*.fasta
test_*.fasta
test_fip_*.fasta

# ----- Rapports générés automatiquement / Auto-generated reports -----
# Ces fichiers sont générés par le pipeline, pas à versionner
# These files are generated by the pipeline, not to be versioned
rapport_*.txt
*_report.txt
*_report_*.txt
dimer_analysis_*.txt
dimer_analysis_*.csv
dimer_analysis_*.html
dengue_*_report*.txt

# ----- Fichiers de test et debug / Test and debug files -----
test_report.txt

# ----- Python -----
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ----- macOS -----
.DS_Store
.AppleDouble
.LSOverride

# ----- Environnements virtuels / Virtual environments -----
venv/
env/
.env
.venv/

# ----- Logs -----
*.log
